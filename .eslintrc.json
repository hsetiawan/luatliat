{
  "env": {
    "es6": true,
    "browser": true
  },
  "globals": {
    "SpreadsheetApp": "readonly",
    "HtmlService": "readonly",
    "Utilities": "readonly",
    "Session": "readonly",
    "Logger": "readonly",
    "console": "readonly",
    "google": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "semi": ["warn", "always"],
    "no-console": "off",
    "no-redeclare": "warn",
    "eqeqeq": "warn"
  }
}
